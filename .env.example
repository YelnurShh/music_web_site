# ==========================================================================
# Firebase баптаулары (міндетті емес)
#
# Осы файлды `.env.local` деп көшіріп, өз Firebase жобаңыздың мәндерін жазыңыз:
#   cp .env.example .env.local
#
# Мәндер Firebase консолінен алынады:
#   Firebase Console → жобаңыз → ⚙️ Project settings → Your apps → Web app → SDK setup
#
# ЕСКЕРТУ: бұл айнымалылар жоқ болса да сайт толық жұмыс істейді —
# таңдаулылар мен нәтижелер браузерде (localStorage) сақталады.
# ==========================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
